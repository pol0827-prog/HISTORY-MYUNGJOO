# Firebase 설정값(history-myungjoo)은 이미 src/firebase.js 에 들어 있어서 넣지 않아도 됩니다.

# Google AI Studio(https://aistudio.google.com/apikey)에서 받은 Gemini API 키 ← Vercel에 이것만 넣으면 돼요
# ⚠️ 앞에 VITE_ 를 붙이지 마세요. 붙이면 학생 화면에 키가 노출됩니다.
GEMINI_API_KEY=
# 선택: 다른 모델을 쓰고 싶을 때만 (기본 gemini-3.5-flash-lite)
GEMINI_MODEL=

# 교사 관리 모드 비밀번호는 여기가 아니라 firestore.rules 파일 안에 있어요.
