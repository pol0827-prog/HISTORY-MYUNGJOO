rules_version = '2';
// ─────────────────────────────────────────────────────────────
//  시대를 헤쳐가는 지혜를 배우는 즐거운 역사수업 - Firestore 보안 규칙
//  Firebase 콘솔 > Firestore Database > 규칙 탭에 전체를 붙여넣고 [게시]
//
//  ▶ 교사 관리 모드 비밀번호는 아래 TEACHER_PIN 한 곳에만 있습니다.
//    바꾸려면 아래 '여기에-비밀번호'를 실제 비밀번호로 고쳐서 [게시]하세요. (앱 코드는 고칠 필요 없음)
//  ▶ 비밀번호가 들어 있으니 GitHub 저장소는 Private(비공개)로 만드세요.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function TEACHER_PIN() { return '여기에-비밀번호'; }  // 공개 저장소라 실제 비밀번호는 Firebase 콘솔 규칙 탭에만 넣으세요

    // 비밀번호를 맞힌 기기(익명 로그인)만 교사로 인정
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }
    function validSid(v) { return v is string && v.matches('^[0-9]{4,6}$'); }
    function text(v, max) { return v is string && v.trim().size() > 0 && v.size() <= max; }

    // 교사 로그인 기록: 비밀번호가 맞을 때만 만들어짐
    match /sessions/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'at'])
        && request.resource.data.pin == TEACHER_PIN();
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // 오늘 배움 마무리: 일기 (수업 화면에 보이는 정보만, 이름 없음)
    match /entries/{id} {
      allow read: if resource.data.hidden == false || isTeacher();
      allow create: if isTeacher() || request.resource.data.keys().hasOnly(['sid', 'nick', 'body', 'hidden', 'createdAt'])
        && validSid(request.resource.data.sid)
        && (!('nick' in request.resource.data) || text(request.resource.data.nick, 40))   // 별명은 이제 배움 시작에서 받음 (예전 화면 호환)
        && text(request.resource.data.body, 300)
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;   // (교사는 저장 기록 불러오기 때 원래 시각으로 복원)
      // 한 사람 1개: 같은 학번·이름이면 학생이 고칠 수 있음 (이름 확인은 entryNames를 같은 묶음으로 쓸 때)
      allow update: if isTeacher() || (request.resource.data.keys().hasOnly(['sid', 'nick', 'body', 'hidden', 'createdAt'])
        && request.resource.data.sid == resource.data.sid
        && (!('nick' in request.resource.data) || text(request.resource.data.nick, 40))
        && text(request.resource.data.body, 300)
        && request.resource.data.hidden == resource.data.hidden
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/entryNames/$(id)).data.at == request.time);
      allow delete: if isTeacher();
    }

    // 오늘 배움 마무리: 학생 이름 (교사만 볼 수 있음)
    match /entryNames/{id} {
      allow create: if isTeacher() || request.resource.data.keys().hasOnly(['sid', 'name', 'at'])
        && validSid(request.resource.data.sid)
        && text(request.resource.data.name, 20)
        && existsAfter(/databases/$(database)/documents/entries/$(id));
      // 고칠 때: 학번·이름이 처음과 같아야 함
      allow update: if isTeacher() || (request.resource.data.keys().hasOnly(['sid', 'name', 'at'])
        && request.resource.data.sid == resource.data.sid
        && request.resource.data.name == resource.data.name
        && request.resource.data.at == request.time);
      allow read, delete: if isTeacher();
    }

    // 오늘 배움 시작: 연상 단어 + 나의 별명 (원본처럼 학번·이름이 수업 화면에 보임)
    match /intro/{id} {
      allow read: if resource.data.hidden == false || isTeacher();
      allow create: if isTeacher() || request.resource.data.keys().hasOnly(['sid', 'name', 'w1', 'w2', 'nick', 'hidden', 'createdAt'])
        && validSid(request.resource.data.sid)
        && text(request.resource.data.name, 20)
        && text(request.resource.data.w1, 20)
        && text(request.resource.data.w2, 20)
        && (!('nick' in request.resource.data) || text(request.resource.data.nick, 40))   // 나의 별명 (배움 시작)
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;
      // 한 사람 1개: 같은 학번·이름이면 학생이 고칠 수 있음
      allow update: if isTeacher() || (request.resource.data.keys().hasOnly(['sid', 'name', 'w1', 'w2', 'nick', 'hidden', 'createdAt'])
        && request.resource.data.sid == resource.data.sid
        && request.resource.data.name == resource.data.name
        && text(request.resource.data.w1, 20)
        && text(request.resource.data.w2, 20)
        && (!('nick' in request.resource.data) || text(request.resource.data.nick, 40))
        && request.resource.data.hidden == resource.data.hidden
        && request.resource.data.createdAt == request.time);
      allow delete: if isTeacher();
    }

    // 🎤 발표 자료: 학생은 자동 익명 로그인으로 올리고, 자기 기기(owner)에서만 다시 고치거나 지울 수 있음
    function validPresent(d) {
      return d.keys().hasOnly(['sid', 'name', 'kind', 'title', 'body', 'links', 'thumb', 'nPhotos', 'hasPin', 'owner', 'hidden', 'order', 'createdAt', 'updatedAt'])
        && validSid(d.sid) && text(d.name, 60) && d.kind in ['solo', 'group'] && text(d.title, 60)
        && d.body is string && d.body.size() <= 3000
        && d.links is list && d.links.size() <= 3
        && d.thumb is string && d.thumb.size() <= 60000
        && d.nPhotos is int && d.nPhotos >= 0 && d.nPhotos <= 4
        && d.updatedAt == request.time;
    }
    match /presents/{id} {
      allow read: if resource.data.hidden == false || isTeacher();
      allow create: if isTeacher() || (request.auth != null && validPresent(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.hidden == false
        && request.resource.data.order == 0
        && request.resource.data.createdAt == request.time);
      // 올린 기기(owner)이거나, 🔒 비밀번호를 맞힌 기기이거나, 비밀번호가 없던 예전 발표는 학번이 같으면 고칠 수 있음
      allow update: if isTeacher() || (request.auth != null
        && (resource.data.owner == request.auth.uid
          || exists(/databases/$(database)/documents/presentUnlock/$(request.auth.uid + '__' + id))
          || (!exists(/databases/$(database)/documents/presentKeys/$(id)) && request.resource.data.sid == resource.data.sid))
        && validPresent(request.resource.data)
        && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['owner', 'hidden', 'order', 'createdAt']));
      allow delete: if isTeacher() || (request.auth != null && resource.data.owner == request.auth.uid);
    }
    // 발표 사진 (발표 화면을 열 때만 불러옴)
    match /presentPhotos/{id} {
      allow read: if true;
      allow create, update: if isTeacher() || (request.auth != null
        && request.resource.data.keys().hasOnly(['photos', 'caps', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 4
        && request.resource.data.caps is list && request.resource.data.caps.size() <= 4
        && request.resource.data.owner == getAfter(/databases/$(database)/documents/presents/$(id)).data.owner
        && (getAfter(/databases/$(database)/documents/presents/$(id)).data.owner == request.auth.uid
          || getAfter(/databases/$(database)/documents/presents/$(id)).data.updatedAt == request.time));
      allow delete: if isTeacher() || (request.auth != null && resource.data.owner == request.auth.uid);
    }

    // 🔒 발표 비밀번호 (숫자 4자리): 아무도 읽을 수 없음. 처음 한 번만 정할 수 있고, 바꾸거나 지우는 것은 선생님만
    match /presentKeys/{id} {
      allow read: if false;
      allow create: if isTeacher() || (request.auth != null
        && request.resource.data.keys().hasOnly(['pin']) && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4}$'));
      allow update, delete: if isTeacher();
    }
    // 비밀번호 확인: 맞는 비밀번호를 넣은 기기만 이 문서를 만들 수 있고, 그 기기는 그 발표를 고칠 수 있음
    match /presentUnlock/{key} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['pres', 'pin'])
        && key == request.auth.uid + '__' + request.resource.data.pres
        && request.resource.data.pin == get(/databases/$(database)/documents/presentKeys/$(request.resource.data.pres)).data.pin;
      allow delete: if isTeacher();
    }

    // 💬 발표 댓글: 학번·종류·내용은 누구나 보고, 이름(pcommentNames)은 교사만
    match /pcomments/{id} {
      allow read: if resource.data.hidden == false || isTeacher();
      allow create: if isTeacher() || (request.resource.data.keys().hasOnly(['pres', 'sid', 'type', 'body', 'hidden', 'createdAt'])
        && request.resource.data.pres is string
        && exists(/databases/$(database)/documents/presents/$(request.resource.data.pres))
        && validSid(request.resource.data.sid)
        && request.resource.data.type in ['내용', '느낀 점', '배운 점', '소감', '질문']
        && text(request.resource.data.body, 300)
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time);
      // 발표 하나에 한 사람 1개: 같은 학번·이름이면 고칠 수 있음
      allow update: if isTeacher() || (request.resource.data.keys().hasOnly(['pres', 'sid', 'type', 'body', 'hidden', 'createdAt'])
        && request.resource.data.pres == resource.data.pres
        && request.resource.data.sid == resource.data.sid
        && request.resource.data.type in ['내용', '느낀 점', '배운 점', '소감', '질문']
        && text(request.resource.data.body, 300)
        && request.resource.data.hidden == resource.data.hidden
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/pcommentNames/$(id)).data.at == request.time);
      allow delete: if isTeacher();
    }
    match /pcommentNames/{id} {
      allow create: if isTeacher() || (request.resource.data.keys().hasOnly(['sid', 'name', 'at'])
        && validSid(request.resource.data.sid)
        && text(request.resource.data.name, 20)
        && existsAfter(/databases/$(database)/documents/pcomments/$(id)));
      allow update: if isTeacher() || (request.resource.data.keys().hasOnly(['sid', 'name', 'at'])
        && request.resource.data.sid == resource.data.sid
        && request.resource.data.name == resource.data.name
        && request.resource.data.at == request.time);
      allow read, delete: if isTeacher();
    }
    // 👏👍❤️ 칭찬: 기기(익명 로그인)마다 발표 하나에 이모지별로 한 번
    match /presentLikes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pres', 'uid', 'k', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.k in ['clap', 'good', 'heart']
        && id == request.resource.data.pres + '_' + request.auth.uid + '_' + request.resource.data.k
        && request.resource.data.at == request.time;
      allow delete: if isTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // 🧑‍🏫 저장된 판서: 교사만 (지금 칠판은 settings/board)
    match /boards/{id} {
      allow read, write: if isTeacher();
    }

    // 반별 수업 기록 (학생 이름 포함): 교사만
    match /archives/{id} {
      allow read, write: if isTeacher();
    }

    // 화면 설정, 추천, AI 추천, 지금 화면(배움 시작/마무리): 누구나 읽기, 교사만 바꾸기
    match /settings/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }
  }
}
